{
    "name": "survos/media-bundle",
    "description": "Manage media without direct relationships",
    "keywords": [
        "symfony-ux",
        "symfony",
        "ux"
    ],
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": "^8.5",
        "doctrine/dbal": "^4.3.2",
        "doctrine/doctrine-bundle": "^3.0",
        "league/flysystem": "^3.0",
        "survos/data-contracts": "^2.27.1",
        "survos/field-bundle": "^2.5",
        "survos/iiif-bundle": "^2.7",
        "survos/imgproxy-bundle": "^2.28.6",
        "survos/kit-bundle": "^2.5",
        "symfony/config": "8.2.*@dev",
        "symfony/dependency-injection": "8.2.*@dev",
        "symfony/http-kernel": "8.2.*@dev",
        "symfony/messenger": "8.2.*@dev",
        "symfony/remote-event": "8.2.*@dev",
        "symfony/ux-twig-component": "^3.0",
        "symfony/webhook": "8.2.*@dev",
        "twig/twig": "^3.4|^4.0",
        "survos/workflow-extras-bundle": "^2.42.8",
        "survos/workflow-messenger-bundle": "^2.42.9",
        "survos/menu-bundle": "^2.42.7",
        "symfony/workflow": "8.2.*@dev"
    },
    "suggest": {
        "survos/tabler-bundle": "Admin navbar menu and the search/UI templates. Optional: MediaMenuSubscriber is only registered when TablerBundle is present (config/services.php), so a headless/CLI client does not need it. Was ^2.5.",
        "symfony/ai-platform": "Required for #[With] JSON Schema constraints on MediaSyncItem properties"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "symfony/browser-kit": "8.2.*@dev",
        "symfony/framework-bundle": "8.2.*@dev",
        "symfony/phpunit-bridge": "8.2.*@dev",
        "symfony/twig-bundle": "8.2.*@dev",
        "symfony/var-dumper": "8.2.*@dev",
        "openai-php/client": "^v0.19.0",
        "symfony/http-client": "8.2.*@dev",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Survos\\MediaBundle\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
